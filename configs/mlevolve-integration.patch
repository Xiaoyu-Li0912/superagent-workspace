+
+def _host_call(method, **kwargs):
+    from .model_profiles import get_profile, get_thinking_extra_body, thinking_json_incompatible
+    model = kwargs.get("model") or kwargs["cfg"].agent.code.model
+    schema = kwargs.get("json_schema")
